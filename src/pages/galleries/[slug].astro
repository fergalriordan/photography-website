---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { galleries } from "../../data/galleries";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../data/site";

export async function getStaticPaths() {
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
  }));
}

const { slug } = Astro.params;
const gallery = galleries.find((g) => g.slug === slug);

if (!gallery) {
  throw new Error(`Gallery not found: ${slug}`);
}

// Each image is snapped to one of two fixed aspect ratios (landscape 3:2 /
// portrait 2:3) so the column packer deals with just two tile heights and can
// end the grid flush. The source photos are already very close to these ratios,
// so the object-cover crop is minimal.
const orientation = (p: { width: number; height: number }) =>
  p.width >= p.height ? "landscape" : "portrait";
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${SITE_TITLE} | ${gallery.title.toUpperCase()}`}
      description={gallery.metaDescription ??
        (gallery.description.length
          ? gallery.description.join(' ')
          : SITE_DESCRIPTION)}
    />
    <style>
      .header-fade-in {
        animation: headerFadeIn 0.9s ease both;
      }
      @keyframes headerFadeIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      .grid-fade-up {
        opacity: 0;
        transform: translateY(16px);
        animation: gridFadeUp 0.8s ease 0.3s both;
      }
      @keyframes gridFadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body class="bg-background pt-16">
    <Header />
    <main class="px-2 py-4">
      <div class="header-fade-in">
        <h1 class="text-gray-dark text-lg md:text-3xl tracking-[0.15em] mb-4 text-center">
          {gallery.name}
        </h1>

        <hr class="border-t border-gray-light mb-6 w-2/3 mx-auto" />

        {/* Galleries with no description show a single rule under the title
            instead of an empty gap between two rules. */}
        {gallery.description.length > 0 && (
          <>
            {gallery.description.map((paragraph) => (
              <p class="text-gray text-xs md:text-base mb-4 px-4 md:px-20 text-center">
                {paragraph}
              </p>
            ))}

            <hr class="border-t border-gray-light mb-6 w-2/3 mx-auto" />
          </>
        )}
      </div>

      {/* Packing spreads the first few data images across all four columns, so
          eager-load enough to cover the top row of every column. */}
      <div class="photo-columns grid-fade-up" data-gallery={slug}>
        {gallery.photos.map((photo, i) => (
          <img
            src={photo.src}
            alt={photo.alt || `${gallery.name} — photo ${i + 1}`}
            loading={i < 6 ? "eager" : "lazy"}
            decoding="async"
            width={photo.width}
            height={photo.height}
            class={`w-full block ${orientation(photo)}`}
          />
        ))}
      </div>
    </main>

    <Footer />

    <script>
      import initGalleryColumns from '../../scripts/galleryColumns.ts';
      initGalleryColumns();
    </script>
  </body>
</html>
