---
interface ImageItem {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

interface Props {
  title: string;
  images: ImageItem[];
  galleryUrl: string;
  class?: string;
  firstSection?: boolean;
}

const {
  title,
  images,
  galleryUrl,
  class: extraClass = "",
  firstSection = false,
} = Astro.props as Props;
---

<section class={`destination-section w-full pt-6 pb-4 bg-background border-t border-gray-light ${extraClass} scroll-mt-16`}>
  <!-- Banner -->
  <div class="text-center mb-5 px-5">
    <h2 class="text-xl md:text-4xl text-text tracking-[0.2em]">
      <a
        href={galleryUrl}
        class="inline-block no-underline text-inherit hover:text-accent transition-colors duration-300"
      >
        {title}
      </a>
    </h2>
  </div>

  <!-- Horizontal Scrollable Row with Arrows -->
  <div class="relative group">
    <!-- Left Arrow Button -->
    <button
      type="button"
      aria-label="Previous slide"
      data-arrow="prev"
      class="absolute left-2 top-1/2 -translate-y-1/2 p-1 rounded-full bg-transparent hover:bg-white/20 transition-opacity transition-colors opacity-0 z-10"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 text-white"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
        ></path>
      </svg>
    </button>

    <!-- Right Arrow Button -->
    <button
      type="button"
      aria-label="Next slide"
      data-arrow="next"
      class="absolute right-2 top-1/2 -translate-y-1/2 p-1 rounded-full bg-transparent hover:bg-white/20 transition-opacity transition-colors opacity-0 z-10"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 text-white"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </button>

    <!-- Floating Gallery Button -->
    <div class="gallery-button absolute top-4 right-4 z-20 opacity-0 transition-opacity duration-300">
      <a
        href={galleryUrl}
        class="bg-black/40 backdrop-blur-sm text-white px-4 py-2 text-[0.65rem] tracking-[0.2em] uppercase hover:bg-black/60 transition-all duration-300 flex items-center gap-2"
      >
        <span>View Gallery</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- Scrollable Container -->
    <div
      class="scroll-container overflow-x-auto scrollbar-hide snap-x snap-mandatory"
      data-scroll-target
    >
      <div class="grid auto-cols-max grid-flow-col gap-2">
        {
          images.map(({ src, alt, width, height }, index) => {
            const isEager = firstSection && index < 4;
            const isHero  = firstSection && index === 0;
            return (
              // Wrapping each image keeps clicks on the carousel going to the
              // gallery without covering the scroller with an overlay link,
              // which would break touch scrolling.
              <a href={galleryUrl} class="block snap-center" aria-label={`View the ${title} gallery`}>
                <img
                  src={src}
                  alt={alt}
                  style={width && height ? `aspect-ratio: ${width} / ${height}` : undefined}
                  class="object-cover h-[30rem] md:h-[35rem]"
                  loading={isEager ? "eager" : "lazy"}
                  fetchpriority={isHero ? "high" : undefined}
                  decoding={isHero ? "sync" : "async"}
                />
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import initDestinationSection from '../scripts/destinationSection.ts';
  initDestinationSection();
</script>