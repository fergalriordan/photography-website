---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
let matchPath = '/' + (subpath?.[0] || '');
if (matchPath === '/galleries') matchPath = '/destinations'; // Keep the GALLERIES link (/destinations) active on individual gallery pages
const isActive = href === pathname || href === matchPath;
---

<a
  href={href}
class={
  [
    'inline-block text-sm tracking-[0.12em]',
    className?.replace(/\btext-\S+/g, ''), // remove existing text color classes
    isActive ? 'font-bold text-accent' : 'text-text',
  ].filter(Boolean).join(' ')
}
  {...props}
>
  <slot />
</a>
