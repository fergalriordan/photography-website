---
import HeaderLink from "./HeaderLink.astro";
---

<header class="fixed top-0 left-0 w-full bg-background border-b border-gray-300 z-50">
  <nav class="flex flex-wrap items-center w-full">
    <!-- Top row: fixed 64px tall so the bar keeps its height whether or not
         the mobile menu below it is open. -->
    <div class="flex items-center justify-between w-full md:w-auto md:flex-1 h-16">
      <h1 class="leading-none m-0 px-10 text-left md:text-left flex-none">
        <a
          href="/"
          class="no-underline text-text block m-0 text-sm tracking-[0.12em] uppercase font-bold"
        >
          Fergal Riordan
        </a>
      </h1>

      <button
        class="md:hidden px-4 text-2xl text-text focus:outline-none"
        aria-label="Toggle navigation menu"
        id="burger-menu-btn"
        type="button"
      >
        &#9776;
      </button>
    </div>

    <div
      id="header-links"
      class="flex-col md:flex-row flex gap-10 items-center px-10 w-full md:w-auto hidden md:flex pb-6 md:pb-0"
    >
      <HeaderLink href="/">HOME</HeaderLink>
      <HeaderLink href="/destinations">GALLERIES</HeaderLink>
      <!--- <HeaderLink href="/blog">Blog</HeaderLink> -->
      <HeaderLink href="/about">ABOUT</HeaderLink>
    </div>
  </nav>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const btn = document.getElementById("burger-menu-btn");
      const links = document.getElementById("header-links");
      if (btn && links) {
        btn.addEventListener("click", () => {
          links.classList.toggle("hidden");
        });
      }
    });
  </script>
</header>
